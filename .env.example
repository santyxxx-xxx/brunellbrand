# Copia este archivo como .env.local y completa los valores.
# En Vercel: Settings > Environment Variables (mismos nombres).
# ⚠️ Las marcadas como SECRETA nunca se comparten ni se suben a GitHub.

# --- Supabase (Fase 1) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# --- Supabase: clave secreta del servidor (Fase 2) --- SECRETA
# Supabase > Project Settings > API Keys > Secret keys (sb_secret_...)
SUPABASE_SERVICE_ROLE_KEY=

# --- Dirección pública de la tienda (sin barra al final) ---
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# --- PayPhone --- (PAYPHONE_TOKEN es SECRETA)
# PayPhone Developer > tu aplicación > Configuración > Credenciales
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=
# Opcional: pasarela activa (por defecto "payphone")
PASARELA_PAGOS=payphone

# --- Correos con Resend --- (RESEND_API_KEY es SECRETA)
RESEND_API_KEY=
# Remitente con tu dominio verificado en Resend
EMAIL_FROM=Brunel Brand <pedidos@tu-dominio.com>
# Tu correo: recibe el aviso de cada pedido pagado
EMAIL_ADMIN=tu-correo@ejemplo.com
